# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text diff=python
*.pyi text diff=python

# Web / Config
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text
*.md text
*.txt text

# Shell
*.sh text eol=lf
*.bash text eol=lf

# Windows
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.wav binary
*.mp3 binary
*.ogg binary
*.db binary
*.bin binary
*.ckpt binary
*.pt binary
*.pkl binary
*.png binary
*.jpg binary

# Large files (mark for awareness, not LFS)
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
