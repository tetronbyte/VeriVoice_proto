# Backend URL (for Streamlit frontend)
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./verivoice.db

# Paillier HE key file path
PAILLIER_KEY_PATH=./keys/paillier_keys.json

# Ed25519 signing key file path
ED25519_KEY_PATH=./keys/ed25519_key.bin

# ML Models
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
WHISPER_MODEL=large-v3

# Audio preprocessing
SAMPLE_RATE=16000
EMBEDDING_DIM=192
GSM_ENFORCE=false
VAD_TOP_DB=25
PRE_EMPHASIS_COEFF=0.97
PEAK_NORM_TARGET=0.95
NOISE_RMS_THRESHOLD=0.05
MIN_AUDIO_DURATION=1.0

# Encryption
PAILLIER_BITS=2048

# Matching
MATCH_THRESHOLD=0.45

# Enrollment
ENROLLMENT_PHRASES=5

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio (fill in for IVR integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
